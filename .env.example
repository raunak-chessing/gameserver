# Copy this to .env (or export these directly) for local development.

# --- Core ---
PORT=8080
APP_ENV=development

# --- Postgres ---
# No ?schema= here (unlike chessbackend's) — gameserver connects via pgx
# (pgxpool.ParseConfig), which doesn't understand Prisma's ?schema= query
# param and passes it straight through as a raw Postgres startup parameter,
# which Postgres then rejects ("unrecognized configuration parameter
# \"schema\""). Postgres already defaults new databases to the public schema.
# Port 5433, not 5432 — see chessbackend/.env's comment for why.
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/chessing

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- CORS ---
FRONTEND_URL=http://localhost:3000

# --- Error tracking (optional) ---
SENTRY_DSN=
